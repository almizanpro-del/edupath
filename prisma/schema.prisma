// EduPath Prisma schema
// Provider auto-detected from DATABASE_URL:
//   - If DATABASE_URL starts with "file:" → SQLite (local dev)
//   - If DATABASE_URL starts with "postgresql:" → Postgres (production/Vercel)
//
// On Vercel, set DATABASE_URL to your Supabase Postgres connection string.
// Locally, use DATABASE_URL=file:./db/custom.db for SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma supports a special "sqlite" provider, but for cross-compatibility
  // we use the provider that matches the DATABASE_URL.
  // If you're on Vercel with Postgres, ensure DATABASE_URL starts with "postgresql://"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  country         String
  city            String
  website         String
  tuitionUsd      Int
  livingCostUsd   Int
  intlStudentPct  Float
  acceptanceRate  Float?
  currency        String   @default("USD")
  logoUrl         String?
  descriptionEn   String?
  descriptionAr   String?
  pendingReview   Boolean  @default(false) // true = scraped, awaiting editorial review
  // Rihla agent enrichment fields
  hasHalalFood            Boolean? @default(true)
  hasPrayerFacilities     Boolean? @default(true)
  hasGenderSegregatedHousing Boolean? @default(false)
  hasFamilyAccommodation  Boolean? @default(false)
  // Data provenance fields (Phase 1 — Data Integrity)
  verifiedStatus  String   @default("UNVERIFIED") // UNVERIFIED | OFFICIAL_SOURCE_VERIFIED | THIRD_PARTY_CORROBORATED | ESTIMATED | STALE | CONFLICTING_SOURCES
  sourceUrl       String?  // URL of the official source where data was verified
  sourceCategory  String?  // official | government | third_party | estimated | user_submitted
  lastVerifiedAt  DateTime? // When the data was last checked against the source
  dataQualityScore Int     @default(0) // 0-100 completeness score
  // Phase A — Trust repair fields
  dataSource      String?  // Human-readable source description (e.g. "Official university website")
  dataConfidence  String   @default("unverified") // high | medium | low | unverified
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  programs        Program[]
  scholarships    Scholarship[]
  reviews         Review[]
  transferFrom    TransferPathway[] @relation("TransferFrom")
  transferTo      TransferPathway[] @relation("TransferTo")
  events          AnalyticsEvent[]
  leads           Lead[]
  agentMatches    AgentMatch[]
}

model Program {
  id              String   @id @default(cuid())
  universityId    String
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name            String
  degreeLevel     String   // bachelor | master | phd
  field           String
  durationMonths  Int
  language        String
  tuitionUsd      Int
  deadline        String?
  entryReqs       String?
  // Application link — the external URL where students actually apply.
  // When present, the UI shows an "Apply Now" button linking here.
  // When absent, the UI falls back to "Visit Website".
  applicationUrl  String?
  applicationFeeUsd Int?  // one-time application fee, if known
  // Data provenance fields (Phase 1 — Data Integrity)
  verifiedStatus  String   @default("UNVERIFIED") // UNVERIFIED | OFFICIAL_SOURCE_VERIFIED | ESTIMATED | STALE
  sourceUrl       String?  // Official program page URL
  lastVerifiedAt  DateTime?
  agentMatches    AgentMatch[]

  @@index([universityId])
}

model Scholarship {
  id              String   @id @default(cuid())
  universityId    String
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name            String
  amountUsd       Int
  amountType      String   // full | partial | fixed
  eligibility     String
  deadline        String?
  // Application link for the scholarship (often a separate form from
  // university admission).
  applicationUrl  String?

  @@index([universityId])
}

model User {
  id              String   @id @default(cuid())
  supabaseId      String?  @unique // maps to Supabase auth.users.id when user signs in
  email           String   @unique
  name            String
  country         String   @default("Jordan")
  fieldOfInterest String?
  role            String   @default("student") // student | recruiter | admin
  verificationStatus String @default("pending") // pending | verified | rejected
  locale          String   @default("en")
  createdAt       DateTime @default(now())

  // Onboarding fields (Phase 2) — collected after first signup so the
  // directory can be personalized without forcing the user through the
  // full Rihla intake. All nullable until the user completes onboarding.
  educationLevel    String?  // high_school | bachelor | master | phd
  preferredCountries String?  // JSON array of country names, e.g. ["Turkey","Germany"]
  budgetUsd         Int?     // annual budget in USD

  reviews         Review[]
  savedLists      SavedList[]
  subscription    Subscription?
  intakeSessions  IntakeSession[]
  essayReviews    EssayReview[]
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId    String
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  ratingOverall       Int
  ratingAffordability Int
  ratingVisa          Int
  ratingTeaching      Int
  ratingSafety        Int
  ratingSocial        Int
  reviewText      String
  helpfulCount    Int      @default(0)
  moderationStatus String @default("approved") // pending | approved | rejected
  verifiedEnrollment Boolean @default(false)
  tags            String   @default("[]") // JSON array of tags
  // Phase A — Trust repair: mark synthetic/seeded reviews
  isSample        Boolean  @default(false) // true = generated for demo, NOT a real student review
  createdAt       DateTime @default(now())

  @@index([universityId, moderationStatus])
  @@index([userId])
}

model SavedList {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listName        String
  universities    String   @default("[]") // JSON array of university IDs
  isPublic        Boolean  @default(false)
  shareToken      String?  @unique
  createdAt       DateTime @default(now())

  @@index([userId])
}

model TransferPathway {
  id              String   @id @default(cuid())
  fromUniversityId String
  fromUniversity  University @relation("TransferFrom", fields: [fromUniversityId], references: [id], onDelete: Cascade)
  toUniversityId  String
  toUniversity    University @relation("TransferTo", fields: [toUniversityId], references: [id], onDelete: Cascade)
  creditsAccepted Int      // typical number of credits that transfer
  totalCredits    Int      // total credits in the target program
  agreementType   String   // "official" | "informal" | "case-by-case"
  notes           String   // description of the transfer pathway
  requirements    String?  // GPA requirements, course equivalents, etc.
  estimatedSavingsUsd Int? // how much students save by transferring
  createdAt       DateTime @default(now())

  @@index([fromUniversityId])
  @@index([toUniversityId])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  eventType     String   // university_view | search | compare | save | essay_review | scholarship_match | transfer_view | contact_form
  universityId  String?  // related university (if applicable)
  university    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  userId        String?  // authenticated user (if applicable)
  sessionId     String?  // anonymous session ID
  metadata      String   @default("{}") // JSON: { query, filters, field, gpa, etc. }
  country       String?  // user's country (from profile or IP)
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([universityId])
  @@index([userId])
}

model Lead {
  id            String   @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studentName   String
  studentEmail  String
  country       String
  gpa           Float?
  field         String?
  message       String
  status        String   @default("new") // new | contacted | closed
  createdAt     DateTime @default(now())

  @@index([universityId])
  @@index([status])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  tier                  String   @default("free") // free | premium | pro | vip | sponsor_starter | sponsor_growth
  status                String   @default("none") // none | trialing | active | past_due | canceled | expired
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

/// AI essay review history. Each record is one essay submission + the
/// AI's feedback. Persists across sessions so users can track improvement
/// over time and see past reviews on /my-essays.
model EssayReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  essayText     String   // the original essay (max 10000 chars, validated in API)
  // Feedback is stored as a JSON string to avoid over-typing the LLM's
  // response shape. The API route validates the shape before saving.
  feedback      String   // JSON: { scores, overall_score, strengths, weaknesses, line_feedback, rewrite_summary }
  overallScore  Float    // denormalized for easy sorting/filtering
  targetUniversity String? // optional: which university the essay is for
  targetProgram  String? // optional: which program
  applicantCountry String? // optional: applicant's country
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, overallScore])
}

/// Staging table for scraped university data awaiting admin review.
/// Records are created by the scraper pipeline (scripts/scraper/) and
/// promoted to the University table when an admin approves them.
model ScrapedUniversity {
  id              String   @id @default(cuid())
  slug            String
  name            String
  country         String
  city            String
  website         String?
  tuitionUsd      Int      @default(0)
  livingCostUsd   Int      @default(0)
  intlStudentPct  Float    @default(0)
  acceptanceRate  Float?
  currency        String   @default("USD")
  logoUrl         String?
  descriptionEn   String?
  descriptionAr   String?

  // Scraper metadata
  source          String   // openalex | wikipedia | curated
  normalizedName  String   // normalized form for dedup comparison
  qualityScore    Int      @default(0) // 0-100
  qualityBreakdown String? // JSON string of per-field breakdown
  status          String   @default("manual_review") // auto_rejected | manual_review | auto_approved | approved | rejected
  scrapedAt       DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?  // User.id of admin who reviewed

  // Raw data from source (JSON)
  rawData         String?  // JSON string of original source record

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([source, country])
  @@index([normalizedName])
  @@index([status])
  @@index([qualityScore])
}

/// Rihla AI agent — conversational intake session
model IntakeSession {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String   @default("en") // "en" | "ar"
  status          String   @default("in_progress") // in_progress | completed | abandoned

  // Structured intake fields (nullable until collected)
  nationality       String?
  educationLevel    String?
  fieldOfInterest   String?
  preferredCountries String? // JSON array as string for SQLite compat
  budgetUsd         Int?
  languagePref      String?
  degreeLevel       String?
  careerGoal        String?
  specialRequirements String?

  // Conversation transcript
  messages        IntakeMessage[]
  matches         AgentMatch[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model IntakeMessage {
  id         String   @id @default(cuid())
  sessionId  String
  session    IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant" | "system"
  content    String
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

/// Rihla AI agent — match with LLM-generated explanation
model AgentMatch {
  id           String   @id @default(cuid())
  sessionId    String
  session      IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  programId    String?
  program      Program?  @relation(fields: [programId], references: [id])
  relevanceScore Float
  explanation  String   // LLM-generated "Why this matches you" (in session language)
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([universityId])
}
