# EduPath environment variables.
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is in .gitignore.

# Local SQLite (dev only — migrate to Supabase Postgres for production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Supabase (auth + future data backend)
# Get these from your Supabase project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only — NEVER expose to browser
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Stripe (optional — for payments)
# Create products at https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_VIP=price_xxx
STRIPE_PRICE_SPONSOR_STARTER=price_xxx
STRIPE_PRICE_SPONSOR_GROWTH=price_xxx

# Resend (optional — for transactional email)
# Get a free key at https://resend.com (3000 emails/month free)
RESEND_API_KEY=re_xxx

# Cron secret (REQUIRED for /api/cron/* endpoints to function)
# Generate a random secret: `openssl rand -hex 32`
# Set this in Vercel env vars and configure Vercel Cron to send it as a
# Bearer token in the Authorization header.
CRON_SECRET=your-random-secret-here

# Sentry (optional — for error monitoring)
# Get a free DSN at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog (optional — for product analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# LLM Providers — at least one must be set for AI features (Rihla agent,
# essay review, scholarship matching) to work on Vercel.
#
# The app tries providers in this order:
#   1. ZAI sandbox (dev only — auto-detected)
#   2. OpenAI (if OPENAI_API_KEY is set)
#   3. Grok / xAI (if XAI_API_KEY is set)
#   4. ZAI env (if ZAI_TOKEN is set — sandbox token won't work on Vercel)
#
# Recommended: Set OPENAI_API_KEY or XAI_API_KEY for production.

# OpenAI (recommended — most reliable on Vercel)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Grok / xAI (alternative — OpenAI-compatible API)
# Get a key at https://console.x.ai/
XAI_API_KEY=xai-xxxxxxxxxxxx
XAI_MODEL=grok-beta

# ZAI (sandbox only — doesn't work on Vercel)
# These only work in the Z.ai dev sandbox. Do not rely on these for production.
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=Z.ai
ZAI_CHAT_ID=your-chat-id
ZAI_TOKEN=your-jwt-token
ZAI_USER_ID=your-user-id
